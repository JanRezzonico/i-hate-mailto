// Remove the `.example` suffix to use this file as your web-ext config
// to support language changes in development mode.

import { defineWebExtConfig } from 'wxt';

const lang = process.env.DEV_LANG ?? 'en';

export default defineWebExtConfig({
  chromiumArgs: [`--lang=${lang}`],
  startUrls: ['http://localhost:5000/index.html'],
});
